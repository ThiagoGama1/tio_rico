# ==============================================================================
# Tio Rico — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `.env` (ou `.env.local`) e preencha os valores.
# ==============================================================================

# Banco de dados PostgreSQL (obrigatório em runtime para persistência)
# Exemplo local: postgresql://postgres:postgres@localhost:5432/tio_rico
# Exemplo Neon/Supabase/Vercel Postgres: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tio_rico?schema=public"

# Opcional: URL com connection pooling (ex.: PgBouncer / Neon pooled) para runtime serverless.
# Se definida, pode ser usada pelo pool em runtime mantendo DATABASE_URL para migrações/CLI.
DATABASE_URL_POOLED=""

# Provedor de LLM ("anthropic" ou "google")
AI_PROVIDER="anthropic"

# Opcional: sobrescreve o modelo padrão do provedor escolhido
# Exemplos:
#   anthropic -> claude-sonnet-4-5, claude-haiku-4-5
#   google    -> gemini-2.5-flash, gemini-2.5-pro
AI_MODEL=""

# Chave da API Anthropic (obrigatória quando AI_PROVIDER="anthropic")
ANTHROPIC_API_KEY=""

# Chave da API Google Generative AI / Gemini (obrigatória quando AI_PROVIDER="google")
# Alias aceito pela aplicação: GEMINI_API_KEY (se GOOGLE_GENERATIVE_AI_API_KEY estiver vazia)
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""

# Chave da API Firecrawl (opcional; se ausente, a análise continua em modo degradado sem notícias)
FIRECRAWL_API_KEY=""
