generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Auth.js (login sem senha por link no e-mail)
// Modelos padrão do @auth/prisma-adapter. Cada User tem no máximo um
// InvestorProfile (InvestorProfile.userId é único).
// =============================================================================

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  sessions      Session[]
  profile       InvestorProfile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// Domínio
// =============================================================================

model InvestorProfile {
  id                 String           @id @default(cuid())
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name               String
  email              String?
  riskProfile        String
  horizonMonths      Int
  monthlyIncomeCents Int?
  goals              Json
  targetAllocation   Json
  preferences        Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assets             PortfolioAsset[]
  checkIns           CheckIn[]

  @@map("investor_profiles")
}

model PortfolioAsset {
  id          String          @id @default(cuid())
  profileId   String
  name        String
  assetClass  String
  amountCents Int
  indexer     String?
  indexerRate Float?
  liquidity   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  profile     InvestorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portfolio_assets")
}

model CheckIn {
  id                String            @id @default(cuid())
  profileId         String
  referenceMonth    String
  userNotes         String
  contributionCents Int
  totalValueCents   Int
  adherenceScore    Float?
  macroSnapshot     Json
  motorResult       Json
  aiAnalysis        Json?
  newsSources       Json?
  createdAt         DateTime          @default(now())
  profile           InvestorProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  positions         CheckInPosition[]

  @@index([profileId, referenceMonth])
  @@index([profileId, createdAt])
  @@map("check_ins")
}

model CheckInPosition {
  id            String  @id @default(cuid())
  checkInId     String
  assetClass    String
  assetLabel    String
  amountCents   Int
  allocationPct Float
  targetPct     Float
  checkIn       CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
  @@map("check_in_positions")
}

model MacroSnapshot {
  id              String   @id @default(cuid())
  selicMetaAnnual Float
  selicDate       String
  cdiAnnual       Float
  cdiDaily        Float?
  cdiDate         String
  ipcaMonthly     Float
  ipca12m         Float
  ipcaDate        String
  rawPayload      Json?
  fetchedAt       DateTime @default(now())

  @@index([fetchedAt])
  @@map("macro_snapshots")
}

// =============================================================================
// Limite de requisições (login, envio de código, criação de demo).
// Uma linha por chave (ex.: "login-falha:email", "envio-ip:1.2.3.4"); o
// contador volta a 1 quando a janela vence. Linhas vencidas são apagadas pela
// limpeza diária (/api/cron/limpar-demo).
// =============================================================================

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}
